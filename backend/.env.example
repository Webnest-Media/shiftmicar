# Server
PORT=4000
NODE_ENV=development

# Database (local default)
DATABASE_URL=postgresql://shiftmycar:shiftmycar@127.0.0.1:5432/shiftmycar?schema=public
DIRECT_URL=postgresql://shiftmycar:shiftmycar@127.0.0.1:5432/shiftmycar?schema=public

# Supabase example (replace [YOUR-PASSWORD], then use these instead of local):
# DATABASE_URL=postgresql://postgres.PROJECT_REF:[YOUR-PASSWORD]@aws-0-ap-northeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true
# DIRECT_URL=postgresql://postgres.PROJECT_REF:[YOUR-PASSWORD]@aws-0-ap-northeast-1.pooler.supabase.com:5432/postgres

# Auth
JWT_SECRET=change-me-to-a-long-random-secret
JWT_EXPIRES_IN=7d
ADMIN_EMAIL=admin@shiftmycar.com
ADMIN_PASSWORD=ChangeMe123!

# CORS / URLs
FRONTEND_URL=http://localhost:3000
API_URL=http://localhost:4000

# Media
UPLOAD_DIR=uploads
MAX_UPLOAD_BYTES=5242880
