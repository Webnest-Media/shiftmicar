# ============================================================
#  ShiftMyCar – Hostinger .htaccess
#  Upload this file to public_html/ on Hostinger
#  (same folder as index.html). Domain: https://shiftmycar.co.in
#
#  Next.js static export writes both /about.html AND an /about/
#  folder. Apache must serve the .html file, not the empty folder.
# ============================================================

Options -MultiViews -Indexes
DirectorySlash Off
DirectoryIndex index.html

RewriteEngine On
RewriteBase /

# ── HTTPS + canonical host ───────────────────────────────────
RewriteCond %{HTTPS} !=on
RewriteCond %{HTTP:X-Forwarded-Proto} !https [NC]
RewriteRule ^ https://shiftmycar.co.in%{REQUEST_URI} [L,R=301]

RewriteCond %{HTTP_HOST} ^www\.shiftmycar\.co\.in$ [NC]
RewriteRule ^ https://shiftmycar.co.in%{REQUEST_URI} [L,R=301]

# ── Real files (css, js, images, env.js, *.html) ─────────────
RewriteCond %{REQUEST_FILENAME} -f
RewriteRule ^ - [L]

# ── Clean URLs: /about and /about/ -> /about.html ───────────
RewriteCond %{DOCUMENT_ROOT}/$1.html -f
RewriteRule ^(.+?)/?$ /$1.html [L]

# ── Security headers ─────────────────────────────────────────
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"

    <FilesMatch "\.(css|js|woff2?|ttf|eot|svg|png|jpg|jpeg|gif|ico|webp|mp4)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>

    # env.js is edited on the server; never cache it
    <Files "env.js">
        Header set Cache-Control "no-cache, no-store, must-revalidate"
        Header set Pragma "no-cache"
        Header set Expires "0"
    </Files>

    <FilesMatch "\.(html)$">
        Header set Cache-Control "public, max-age=3600"
    </FilesMatch>
</IfModule>

# ── Gzip ─────────────────────────────────────────────────────
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json
    AddOutputFilterByType DEFLATE image/svg+xml text/xml text/plain
</IfModule>

ErrorDocument 404 /404.html
